<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Catalog\Block\Product\ProductList\Toolbar">
        <plugin name="buhmann_catalog_toolbar_ajax_options" type="Buhmann\Catalog\Plugin\Block\Product\ProductList\Toolbar" />
    </type>
    <type name="Magento\Catalog\Controller\Category\View">
        <plugin name="buhmann_catalog_ajax_category_view_json" type="Buhmann\Catalog\Plugin\Controller\CategoryView" />
    </type>
    <type name="Magento\LayeredNavigation\Block\Navigation">
        <plugin name="buhmann_catalog_navigation" type="Buhmann\Catalog\Plugin\Block\Navigation" sortOrder="10" />
    </type>

    <type name="Magento\Catalog\Model\Layer\Filter\FilterInterface">
        <plugin name="buhmann_catalog_filter_items" type="Buhmann\Catalog\Plugin\Model\Layer\Filter\FilterItems" sortOrder="10" />
    </type>
</config>
